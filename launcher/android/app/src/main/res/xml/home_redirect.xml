<?xml version="1.0" encoding="utf-8"?>
<!-- canRetrieveWindowContent lets the service check whether Amazon's Settings grid is showing.
     After this service is switched off and on, Amazon's launcher sends it no events until the next
     screen change, so test from our home screen first. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged|typeViewFocused"
    android:packageNames="com.amazon.tv.launcher,com.lucas.tv_home"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds"
    android:notificationTimeout="100"
    android:canRetrieveWindowContent="true"
    android:description="@string/home_redirect_description" />
